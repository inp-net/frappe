{
	"name": "frappe",
	"version": "0.0.0",
	"description": "",
	"scripts": {
		"dev:api": "pnpm --filter @frappe/api run dev",
		"dev:app": "pnpm --filter @frappe/app run dev",
		"migration:make": "pnpm --filter @frappe/api run migration:make",
		"db:reset": "pnpm --filter @frappe/api run reset",
		"db:seed": "pnpm --filter @frappe/api run seed",
		"test:api": "pnpm --filter @frappe/api run test",
		"coverage:api": "pnpm --filter @frappe/api run coverage",
		"generate": "pnpm --filter @frappe/api run generate && pnpm --filter @frappe/app run generate"
	},
	"keywords": [],
	"author": "",
	"packageManager": "pnpm@10.29.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
