root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true

# Matches multiple files with brace expansion notation
# Set default charset
[*.{yml,yaml}]
indent_size = 2
indent_style = space


# Matches the exact files either package.json or .travis.yml
[{package.json}]
indent_style = space
indent_size = 2
